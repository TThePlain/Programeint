NODE_ENV=development
APP_NAME=Programeint
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
# Em produção (Vercel): API_URL=https://sua-api.exemplo.com  e  APP_URL=https://teu-site.vercel.app
API_PORT=4000

DATABASE_URL=postgresql://postgres@127.0.0.1:5432/programeint
DATABASE_URL_TEST=postgresql://postgres@127.0.0.1:5432/programeint_test
REDIS_URL=redis://127.0.0.1:6379

SESSION_COOKIE_NAME=programeint_sid
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_MINUTES=30

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Programeint <nao-responder@programeint.local>
MAILPIT_URL=http://127.0.0.1:8025

# BLOCKED/CONFIGURATION_REQUIRED — não marcar como funcional sem estas chaves
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# YOUTUBE_API_KEY=   # opcional — melhora a pesquisa de vídeos do mapa gerado
# LAB_JAVA_IMAGE=eclipse-temurin:21-jdk-alpine
