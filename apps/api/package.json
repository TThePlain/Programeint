{
  "name": "@programeint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "DATABASE_URL=postgresql://postgres@127.0.0.1:5432/programeint_test vitest run",
    "lint": "echo \"lint skipped for api\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
