    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.14.0",
    "@programeint/database": "workspace:*",
    "@programeint/shared": "workspace:*",
    "argon2": "^0.43.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^7.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
